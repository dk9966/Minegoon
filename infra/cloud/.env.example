# Copy to /opt/minegent/.env on the agent host. Never commit the real .env.

# Apex server address and port, from the top of the Apex panel.
MC_HOST=
MC_PORT=25565
# Mineflayer's newest supported version. ViaBackwards on Apex translates it to 26.3.
MC_VERSION=26.1

BOT_USERNAME=Builder
# The password you registered for the bot with /authme register.
BOT_PASSWORD=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
